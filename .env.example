# Copy to .env.local for local development. NEVER commit real values.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Public (browser-safe). From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google Maps JavaScript API browser key (Google Cloud → APIs & Services → Credentials).
# Restrict it by HTTP referrer to the app's URLs, and to the Maps JavaScript API and
# Places API (New). Optional: without it maps show "Map key not configured".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate: openssl rand -hex 32
CRON_SECRET=
# HMAC key for outbound webhooks (outbox dispatcher). Generate: openssl rand -hex 32
OUTBOX_SIGNING_SECRET=
